#!/usr/bin/env bash
# localhost.run tunnels for coding agents: put a local port on the user's
# stable localhost.run domain, keep it up, and report what happened.
#
#   tunnel start <port> [--domain D] [--key K]   start (or replace) the tunnel
#   tunnel start <port> --temporary              the same on a temporary address, with no setup
#   tunnel stop [--domain D | --temporary]       stop it
#   tunnel status [--domain D | --temporary]     state, URL, port, last message
#   tunnel events [--domain D | --temporary] [N] the last N events (default 20)
#   tunnel check [--domain D | --temporary]      is the app answering, locally and through the URL
#   tunnel verify --domain D --key K             check a domain and key work, then save them
#   tunnel keys                                  list the user's public keys
#   tunnel new-key [PATH]                        create a key for localhost.run (default ~/.ssh/localhost_run)
#   tunnel claim-url <name> --key K              the link to claim a managed domain with that key
#   tunnel config                                show the saved domain and key
#
# Configuration: ${XDG_CONFIG_HOME:-~/.config}/localhost-run/agent.conf
# (domain=..., key=...). State, per domain: ${XDG_STATE_HOME:-~/.local/state}/localhost-run/<domain>/
# (a temporary tunnel's is in .../localhost-run/temporary/).
#
# Bash 3.2 compatible (macOS), no jq.

set -u

HOST="${LOCALHOST_RUN_HOST:-localhost.run}"
SSH_PORT="${LOCALHOST_RUN_SSH_PORT:-22}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/localhost-run"
CONFIG="$CONFIG_DIR/agent.conf"
STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/localhost-run"
START_TIMEOUT=30

die() { echo "error: $*" >&2; exit 1; }

config_get() {
    [ -f "$CONFIG" ] || return 0
    sed -n "s/^$1=//p" "$CONFIG" | tail -n 1
}

expand_home() {
    case "$1" in
        "~/"*) echo "$HOME/${1#\~/}" ;;
        *) echo "$1" ;;
    esac
}

# A field from one JSON event line: python3 if there is one, else a grep
# that's right for anything without escaped quotes.
json_field() {
    # $1 = line, $2 = dotted path, e.g. data.message
    if command -v python3 >/dev/null 2>&1; then
        printf '%s' "$1" | python3 -c '
import json, sys
v = json.load(sys.stdin)
for k in sys.argv[1].split("."):
    v = v.get(k) if isinstance(v, dict) else None
print("" if v is None else v)' "$2" 2>/dev/null
    else
        printf '%s' "$1" | grep -o "\"${2##*.}\":\"[^\"]*\"" | head -n 1 | sed 's/^"[^"]*":"//; s/"$//'
    fi
}

event_type() { printf '%s' "$1" | grep -o '"type":"[^"]*"' | head -n 1 | sed 's/.*:"run\.localhost\.//; s/"$//'; }

# The last non-blank line of a file.
last_line() { grep -v '^[[:space:]]*$' "$1" 2>/dev/null | tail -n 1; }

state_dir() { echo "$STATE_ROOT/$1"; }

set_state() {
    # $1 = dir, $2 = state, $3 = message
    printf '%s\n%s\n' "$2" "${3:-}" > "$1/state.tmp" && mv "$1/state.tmp" "$1/state"
}

read_state() { [ -f "$1/state" ] && sed -n 1p "$1/state"; }
read_state_message() { [ -f "$1/state" ] && sed -n 2p "$1/state"; }

alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

ssh_args() {
    # $1 = key, $2 = domain, $3 = port; no domain means a temporary tunnel:
    # nokey@ with no key, and localhost.run picks the address.
    # Each option its own word: never build these into one string.
    local login forward
    if [ -n "$2" ]; then
        login=(-i "$1" -o IdentitiesOnly=yes)
        forward=(-R "$2:80:localhost:$3" "plan@$HOST")
    else
        login=(-o PubkeyAuthentication=no)
        forward=(-R "80:localhost:$3" "nokey@$HOST")
    fi
    SSH_ARGS=(
        "${login[@]}"
        -o BatchMode=yes
        -o StrictHostKeyChecking=accept-new
        -o ExitOnForwardFailure=yes
        -o ServerAliveInterval=30
        -o ServerAliveCountMax=3
        -o ConnectTimeout=15
        -p "$SSH_PORT"
        "${forward[@]}"
        --
        --output json
        --requests
    )
}

# The supervisor: runs ssh, records its events, reconnects after drops,
# and gives up for good on a refused key or a denied domain.
supervise() {
    local dir="$1" key="$2" domain="$3" port="$4"
    local events="$dir/events.jsonl" err="$dir/ssh.err" backoff=2 sshpid=""
    ssh_args "$key" "$domain" "$port"
    while :; do
        local from
        from=$(( $(wc -l < "$events") + 1 ))
        : > "$err"
        ssh "${SSH_ARGS[@]}" < /dev/null >> "$events" 2>> "$err" &
        sshpid=$!
        echo "$sshpid" > "$dir/ssh.pid"
        local seen=0
        while alive "$sshpid"; do
            local new
            new=$(tail -n +"$from" "$events" 2>/dev/null)
            if printf '%s' "$new" | grep -q '"type":"run.localhost.tunnel.denied"'; then
                local line
                line=$(printf '%s\n' "$new" | grep '"type":"run.localhost.tunnel.denied"' | tail -n 1)
                kill "$sshpid" 2>/dev/null
                set_state "$dir" denied "$(json_field "$line" data.message)"
                exit 0
            fi
            # Every registration, not just the first: a temporary address
            # can move to a new one during the session.
            local count
            count=$(printf '%s\n' "$new" | grep -c '"type":"run.localhost.tunnel.registered"')
            if [ "$count" -gt "$seen" ]; then
                seen=$count
                backoff=2
                local address
                address=$(json_field "$(printf '%s\n' "$new" | grep '"type":"run.localhost.tunnel.registered"' | tail -n 1)" data.address)
                [ -n "$address" ] || address="$domain"
                echo "$address" > "$dir/address"
                set_state "$dir" connected "https://$address"
            fi
            sleep 1
        done
        wait "$sshpid" 2>/dev/null
        local code=$?
        if grep -q "Permission denied" "$err"; then
            set_state "$dir" key_refused "the key $key isn't on a localhost.run account (or needs ssh-add for its passphrase)"
            exit 0
        fi
        set_state "$dir" reconnecting "ssh exited ($code): $(last_line "$err"); retrying in ${backoff}s"
        sleep "$backoff"
        backoff=$(( backoff * 2 > 60 ? 60 : backoff * 2 ))
    done
}

# Is the app answering on the port the tunnel points at? Fast, and tells
# "the app isn't running" apart from a tunnel problem. Prints one line;
# succeeds if the app answered HTTP.
local_check() {
    command -v curl >/dev/null 2>&1 || { echo "local: can't check (no curl)"; return 0; }
    local code status
    code=$(curl -s -o /dev/null -m 3 -w '%{http_code}' "http://localhost:$1/" 2>/dev/null)
    status=$?
    case "$status" in
        0) echo "local: localhost:$1 answers HTTP $code"; return 0 ;;
        7) echo "local: nothing is listening on localhost:$1 (is the app running, and on this port?)" ;;
        28) echo "local: localhost:$1 accepted the connection but didn't answer within 3s" ;;
        *) echo "local: localhost:$1 didn't answer with HTTP (curl exit $status; is it HTTPS, or not a web app?)" ;;
    esac
    return 1
}

# The same through the tunnel: what a visitor gets.
public_check() {
    command -v curl >/dev/null 2>&1 || { echo "public: can't check (no curl)"; return 0; }
    local code
    code=$(curl -s -o /dev/null -m 10 -w '%{http_code}' "https://$1/" 2>/dev/null)
    if [ $? -eq 0 ]; then
        echo "public: https://$1/ answers HTTP $code"
    else
        echo "public: https://$1/ didn't answer within 10s"
        return 1
    fi
}

stop_domain() {
    local dir
    dir=$(state_dir "$1")
    local sup ssh_pid
    # The supervisor first, outright, so it can't start another ssh or
    # write its state over a new tunnel's; then its ssh.
    sup=$(cat "$dir/supervisor.pid" 2>/dev/null)
    alive "$sup" && kill -9 "$sup" 2>/dev/null
    ssh_pid=$(cat "$dir/ssh.pid" 2>/dev/null)
    alive "$ssh_pid" && kill "$ssh_pid" 2>/dev/null
    rm -f "$dir/supervisor.pid" "$dir/ssh.pid"
    [ -d "$dir" ] && set_state "$dir" stopped "stopped"
}

parse_common() {
    DOMAIN=""; KEY=""; TEMPORARY=""; REST=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --domain) DOMAIN="${2:-}"; shift 2 ;;
            --key) KEY="${2:-}"; shift 2 ;;
            --temporary) TEMPORARY=1; shift ;;
            *) REST+=("$1"); shift ;;
        esac
    done
    if [ -n "$TEMPORARY" ]; then
        [ -z "$DOMAIN" ] || die "--temporary and --domain: choose one"
        # The state directory's name; a domain always has a dot, so it
        # can't clash with one.
        TARGET=temporary
        return 0
    fi
    [ -n "$DOMAIN" ] || DOMAIN=$(config_get domain)
    [ -n "$KEY" ] || KEY=$(config_get key)
    KEY=$(expand_home "$KEY")
    TARGET="$DOMAIN"
}

# The address a tunnel is (or was last) on.
tunnel_address() {
    local a
    a=$(cat "$(state_dir "$1")/address" 2>/dev/null)
    echo "${a:-$1}"
}

need_config() {
    [ -n "$DOMAIN" ] && [ -n "$KEY" ] || die "not set up: no stable domain or key saved in $CONFIG. Follow the skill's setup guide to claim a domain that stays the same. (Only if the user chooses a temporary address instead: tunnel start <port> --temporary)"
    [ -f "$KEY" ] || die "key file $KEY doesn't exist"
}

cmd_start() {
    parse_common "$@"
    [ -n "$TEMPORARY" ] || need_config
    local port="${REST[0]:-}"
    case "$port" in ''|*[!0-9]*) die "usage: tunnel start <port> [--domain D] [--key K] | tunnel start <port> --temporary" ;; esac
    command -v ssh >/dev/null || die "ssh isn't installed"

    local dir
    dir=$(state_dir "$TARGET")
    # One tunnel per domain: the server shares a domain's traffic across
    # every session holding it, so a leftover one would take requests.
    stop_domain "$TARGET"
    mkdir -p "$dir"
    : > "$dir/events.jsonl"
    rm -f "$dir/address"
    echo "$port" > "$dir/port"
    set_state "$dir" starting "connecting"

    # Detached, so it outlives the agent's shell command.
    local detach=nohup
    command -v setsid >/dev/null 2>&1 && detach=setsid
    $detach bash "$0" __supervise "$dir" "$KEY" "$DOMAIN" "$port" < /dev/null > /dev/null 2>&1 &
    echo $! > "$dir/supervisor.pid"

    local i state
    for i in $(seq 1 "$START_TIMEOUT"); do
        state=$(read_state "$dir")
        case "$state" in connected|denied|key_refused) break ;; esac
        sleep 1
    done
    state=$(read_state "$dir")
    case "$state" in
        connected)
            local address
            address=$(tunnel_address "$TARGET")
            echo "connected: https://$address -> localhost:$port"
            # Through the tunnel only if the app answers locally: otherwise
            # that's the answer, and the public check would just time out.
            if local_check "$port"; then
                public_check "$address"
            else
                echo "the tunnel is up, and will work as soon as the app answers on localhost:$port"
            fi
            if [ -n "$TEMPORARY" ]; then
                echo "note: this is a temporary address. Free addresses change periodically to prevent abuse, so links to it will stop working; a stable domain stays the same (see the skill's setup guide)."
                echo "note: anyone with the URL can reach localhost:$port while the tunnel is up. Stop it with: tunnel stop --temporary"
            else
                echo "note: anyone with the URL can reach localhost:$port while the tunnel is up. Stop it with: tunnel stop"
            fi
            ;;
        denied)
            local why
            why=$(read_state_message "$dir")
            stop_domain "$TARGET"
            set_state "$dir" denied "$why"
            echo "denied: $why"
            exit 2
            ;;
        key_refused)
            echo "key refused: $(read_state_message "$dir")"
            exit 3
            ;;
        *)
            echo "not connected after ${START_TIMEOUT}s: $(read_state_message "$dir")"
            echo "it keeps retrying in the background; check with: tunnel status, or stop it with: tunnel stop"
            exit 4
            ;;
    esac
}

cmd_stop() {
    parse_common "$@"
    [ -n "$TARGET" ] || die "no domain given or saved"
    stop_domain "$TARGET"
    echo "stopped: $(tunnel_address "$TARGET")"
}

cmd_status() {
    parse_common "$@"
    local domains=()
    if [ -n "$TEMPORARY" ] || [ -n "$DOMAIN" ]; then
        domains=("$TARGET")
    elif [ -d "$STATE_ROOT" ]; then
        local d
        for d in "$STATE_ROOT"/*/; do [ -d "$d" ] && domains+=("$(basename "$d")"); done
    fi
    [ ${#domains[@]} -gt 0 ] || { echo "no tunnels"; return 0; }
    local domain dir state sup
    for domain in "${domains[@]}"; do
        dir=$(state_dir "$domain")
        state=$(read_state "$dir")
        sup=$(cat "$dir/supervisor.pid" 2>/dev/null)
        # A supervisor that died (e.g. a reboot) leaves a stale state.
        case "$state" in
            connected|reconnecting|starting) alive "$sup" || state="stopped" ;;
        esac
        local port
        port=$(cat "$dir/port" 2>/dev/null)
        local label="$domain"
        [ "$domain" = temporary ] && label="temporary ($(tunnel_address temporary))"
        echo "$label: ${state:-unknown}, localhost:$port - $(read_state_message "$dir")"
        case "$state" in
            connected|reconnecting|starting) [ -n "$port" ] && echo "  $(local_check "$port")" ;;
        esac
    done
}

cmd_check() {
    parse_common "$@"
    [ -n "$TARGET" ] || die "no domain given or saved"
    local dir port state
    dir=$(state_dir "$TARGET")
    port=$(cat "$dir/port" 2>/dev/null)
    [ -n "$port" ] || die "no tunnel for $TARGET: start one with: tunnel start <port>"
    state=$(read_state "$dir")
    alive "$(cat "$dir/supervisor.pid" 2>/dev/null)" || state=stopped
    local ok=0
    case "$state" in
        connected) ;;
        *) echo "public: the tunnel is $state - $(read_state_message "$dir")"; ok=1 ;;
    esac
    if local_check "$port"; then
        [ "$state" = connected ] && { public_check "$(tunnel_address "$TARGET")" || ok=1; }
    else
        # The public check would only time out.
        ok=1
    fi
    return $ok
}

cmd_events() {
    parse_common "$@"
    [ -n "$TARGET" ] || die "no domain given or saved"
    local n="${REST[0]:-20}" dir line
    dir=$(state_dir "$TARGET")
    [ -f "$dir/events.jsonl" ] || { echo "no events"; return 0; }
    tail -n "$n" "$dir/events.jsonl" | while IFS= read -r line; do
        local t msg
        t=$(event_type "$line")
        case "$t" in
            tunnel.http.request)
                echo "request: $(json_field "$line" data.method) $(json_field "$line" data.path) -> $(json_field "$line" data.status) ($(json_field "$line" data.duration_ms) ms)"
                ;;
            *)
                # Without the terminal-only parts: a free tunnel's welcome
                # has a QR code drawn in escape codes, and blank lines.
                msg=$(json_field "$line" data.message | grep -v "$(printf '\033')" | grep -v 'with this QR' | grep -v '^[[:space:]]*$')
                echo "$t: $msg"
                ;;
        esac
    done
}

cmd_verify() {
    parse_common "$@"
    [ -z "$TEMPORARY" ] || die "verify is for a stable domain: there's nothing to verify for a temporary one"
    need_config
    local dir out err
    dir=$(mktemp -d)
    out="$dir/out"; err="$dir/err"
    # Port 9 (discard): registration doesn't need anything listening.
    ssh_args "$KEY" "$DOMAIN" 9
    ssh "${SSH_ARGS[@]}" < /dev/null > "$out" 2> "$err" &
    local pid=$! i result=""
    for i in $(seq 1 25); do
        if grep -q '"type":"run.localhost.tunnel.registered"' "$out"; then result=ok; break; fi
        if grep -q '"type":"run.localhost.tunnel.denied"' "$out"; then result=denied; break; fi
        alive "$pid" || { result=exited; break; }
        sleep 1
    done
    alive "$pid" && kill "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null
    local user
    user=$(json_field "$(grep '"type":"run.localhost.session.authenticated"' "$out" | head -n 1)" data.user_id)
    case "$result" in
        ok)
            mkdir -p "$CONFIG_DIR"
            printf 'domain=%s\nkey=%s\n' "$DOMAIN" "$KEY" > "$CONFIG"
            echo "ok: $KEY signs in as ${user:-your account}, and $DOMAIN is yours. Saved to $CONFIG"
            ;;
        denied)
            echo "denied: $(json_field "$(grep '"type":"run.localhost.tunnel.denied"' "$out" | tail -n 1)" data.message)"
            echo "the key signed in${user:+ as $user}, but the domain isn't on that account (check the spelling, or that it's set up at https://admin.localhost.run/)"
            rm -rf "$dir"; exit 2
            ;;
        exited)
            if grep -q "Permission denied" "$err"; then
                echo "key refused: $KEY isn't on a localhost.run account yet. Add $KEY.pub at https://admin.localhost.run/ (if it has a passphrase, run ssh-add $KEY first)"
                rm -rf "$dir"; exit 3
            fi
            echo "failed: $(last_line "$err")"
            rm -rf "$dir"; exit 4
            ;;
        *)
            echo "no answer from $HOST after 25s: $(last_line "$err")"
            rm -rf "$dir"; exit 4
            ;;
    esac
    rm -rf "$dir"
}

cmd_keys() {
    local f found=""
    for f in "$HOME"/.ssh/*.pub; do
        [ -f "$f" ] || continue
        found=1
        echo "${f%.pub}: $(ssh-keygen -lf "$f" 2>/dev/null)"
    done
    [ -n "$found" ] || echo "no public keys in ~/.ssh"
}

# The public key file for a key path: the path itself if it's the .pub.
public_key_file() {
    case "$1" in
        *.pub) echo "$1" ;;
        *) echo "$1.pub" ;;
    esac
}

# Percent-encode everything but RFC 3986's unreserved characters, so a
# key's "+", "/", "=" and spaces survive any query-string parser.
url_encode() {
    local s="$1" out="" c i
    for (( i = 0; i < ${#s}; i++ )); do
        c="${s:i:1}"
        case "$c" in
            [A-Za-z0-9.~_-]) out+="$c" ;;
            *) out+=$(printf '%%%02X' "'$c") ;;
        esac
    done
    printf '%s' "$out"
}

cmd_new_key() {
    local path
    path=$(expand_home "${1:-$HOME/.ssh/localhost_run}")
    [ -e "$path" ] || [ -e "$path.pub" ] && die "$path already exists: not overwriting it"
    mkdir -p "$(dirname "$path")" && chmod 700 "$(dirname "$path")" 2>/dev/null
    # No passphrase: an agent can't type one. Only for localhost.run.
    ssh-keygen -q -t ed25519 -N '' -C "localhost.run" -f "$path" || die "ssh-keygen failed"
    echo "created $path (public key: $path.pub)"
    echo "$(ssh-keygen -lf "$path.pub")"
}

cmd_claim_url() {
    parse_common "$@"
    local name="${REST[0]:-}"
    [ -n "$name" ] || die "usage: tunnel claim-url <name> --key K"
    case "$name" in
        *[!a-z0-9-]*|-*|*-) die "a name is lowercase letters, digits and hyphens, not starting or ending with a hyphen" ;;
    esac
    [ -n "$KEY" ] || die "no key given or saved: pass --key"
    local pub
    pub=$(public_key_file "$KEY")
    [ -f "$pub" ] || die "no public key at $pub"
    # Type and key only: the comment is often a username and hostname.
    local key
    key=$(awk 'NF >= 2 { print $1 " " $2; exit }' "$pub")
    [ -n "$key" ] || die "$pub doesn't look like a public key"
    echo "https://admin.localhost.run/claim?managed=true&name=$(url_encode "$name")&ssh_pubkey=$(url_encode "$key")"
}

cmd_config() {
    if [ -f "$CONFIG" ]; then echo "$CONFIG:"; cat "$CONFIG"; else echo "not set up ($CONFIG doesn't exist)"; fi
}

case "${1:-}" in
    start) shift; cmd_start "$@" ;;
    stop) shift; cmd_stop "$@" ;;
    status) shift; cmd_status "$@" ;;
    events) shift; cmd_events "$@" ;;
    check) shift; cmd_check "$@" ;;
    verify) shift; cmd_verify "$@" ;;
    keys) cmd_keys ;;
    new-key) shift; cmd_new_key "$@" ;;
    claim-url) shift; cmd_claim_url "$@" ;;
    config) cmd_config ;;
    __supervise) shift; supervise "$@" ;;
    *) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
